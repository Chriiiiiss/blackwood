# Local development credentials only. Do not reuse in production.
POSTGRES_USER=blackwood
POSTGRES_PASSWORD=booopbeep
POSTGRES_DB=bigbrother
DATABASE_URL=postgresql://blackwood:booopbeep@127.0.0.1:5432/bigbrother

API_PORT=3000
API_HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173

# Optional organizer access. Generate with pnpm organizer:password, then copy
# the single-quoted assignment from .organizer-password.env. Never use VITE_.
ORGANIZER_PASSWORD_HASH=

# Optional absolute media directory. Local default: .media/ at the repository root.
# Production Compose uses the persistent private /media volume.
# MEDIA_ROOT=/absolute/path/to/media
## Optional host-only Vite HTTPS configuration for organizer testing on a phone.
## Keep certificate/private-key files outside the repository.
DEV_TLS_CERT=
DEV_TLS_KEY=
