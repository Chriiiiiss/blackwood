{
  "name": "@blackwood/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "test:db": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --host 127.0.0.1 --port 4983"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.4",
    "@fastify/type-provider-typebox": "6.1.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "sharp": "0.35.5",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
