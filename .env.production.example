# Copy to .env.production on the VPS. Never reuse local development credentials.
POSTGRES_USER=blackwood
POSTGRES_DB=blackwood
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

SITE_ADDRESS=halloween.sirhc.xyz
APP_ORIGIN=https://halloween.sirhc.xyz
# Optional. Copy the single-quoted assignment generated by pnpm organizer:password.
# Keep the quotes: the scrypt encoding contains dollar signs.
ORGANIZER_PASSWORD_HASH=
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Defaults for local image builds. GitHub deployment sets the registry and commit.
IMAGE_PREFIX=blackwood
APP_VERSION=local

# Optional absolute media directory. Local default: .media/ at the repository root.
# Production Compose uses the persistent private /media volume.
# MEDIA_ROOT=/absolute/path/to/media
