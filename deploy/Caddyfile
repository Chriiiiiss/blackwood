{$SITE_ADDRESS} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	@api path /api /api/*
	handle @api {
		request_body {
			max_size 21MiB
		}
		reverse_proxy api:3000
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
